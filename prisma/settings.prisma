model SystemSetting {
  id                       String   @id @default(uuid())
  siteName                 String   @default("Apex POS")
  language                 String   @default("English")
  defaultCurrency          String   @default("BDT")
  accountingMethod         String   @default("AVCO (Average Cost Method)")
  defaultEmail             String   @default("info@apexpos.com")
  defaultCustomerGroup     String   @default("General")
  defaultPriceGroup        String   @default("Default")
  maintenanceMode          String   @default("No")
  theme                    String   @default("Default")
  rtlSupport               String   @default("Disable")
  loginCaptcha             String   @default("Disable")
  numberDaysDisableEditing Int      @default(0)
  rowsPerPage              Int      @default(10)
  dateFormat               String   @default("dd-mm-yyyy")
  timezone                 String   @default("Asia/Dhaka")
  calender                 String   @default("Shared")
  defaultWarehouse         String   @default("Main Warehouse")
  defaultBiller            String   @default("Apex POS")
  pdfLibrary               String   @default("mPDF")
  useCodeForSlug           String   @default("Enable")

  // Products Configuration Sub-section
  productTax               String   @default("Enable")
  racks                    String   @default("Disable")
  productVariants          String   @default("Enable")
  productExpiry            String   @default("Disable")
  removeExpired            String   @default("No, I will remove manually")
  imageWidth               Int      @default(800)
  imageHeight              Int      @default(800)
  thumbnailWidth           Int      @default(150)
  thumbnailHeight          Int      @default(150)
  watermark                String   @default("Yes")
  displayWarehouseProducts String   @default("Hide with 0 quantity")
  barcodeSeparator         String   @default("Dot (.)")
  barcodeRenderer          String   @default("Image")
  updateCostWithPurchase   String   @default("No")

  // Sales Configuration Sub-section
  overSelling              String   @default("Yes")
  referenceFormat          String   @default("Sequence Number")
  orderTax                 String   @default("Vat")
  productLevelDiscount     String   @default("Enable")
  productSerial            String   @default("Enable")
  autoDetectBarcode        String   @default("Enable")
  productsCountFixBarcode  Int      @default(4)
  cartItemAdditionMethod   String   @default("Add New Item to cart")
  defaultOrderPageFocus    String   @default("Add item input")
  ksaInvoiceQrCode         String   @default("Disable")
  invoiceView              String   @default("Standard")

  // Prefix Configuration Sub-section
  salesPrefix              String   @default("SALE")
  returnSalePrefix         String   @default("SR")
  paymentPrefix            String   @default("IPAY")
  purchasePaymentPrefix    String   @default("POP")
  deliveryPrefix           String   @default("DO")
  quotationPrefix          String   @default("QUOTE")
  purchasePrefix           String   @default("PO")
  returnPurchasePrefix     String   @default("PR")
  transferPrefix           String   @default("TR")
  expensePrefix            String   @default("")
  qaPrefix                 String   @default("")

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("tbl_system_settings")
}
